{
  // 大前端主站（React Router 8 全站 SSR）
  // Worker 名不允许下划线；与仓库名不一致是正常的
  "name": "peroe-site",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "115794fc4320d099fff55b1b91999f2c",
  // 构建命令已内嵌：部署时自动执行 generate-posts（博客内容）→ react-router build（SSR 产物）
  "build": {
    "command": "pnpm install && pnpm build"
  },
  "assets": {
    "directory": "./build/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // 论坛后端回源地址（SSR 端直调；构建/运行时可用环境变量覆盖）
    "FORUM_API_BASE": "https://peroe-api.peroe.top"
  }
}
