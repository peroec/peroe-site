{
  "name": "main-site",
  "version": "1.0.0",
  "description": "peroe 大前端主站 —— React Router Framework Mode 全站 SSR 单体应用",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-posts.mjs && react-router build",
    "dev": "node scripts/generate-posts.mjs && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "node scripts/generate-posts.mjs && react-router typegen && tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@marsidev/react-turnstile": "^1.5.4",
    "@react-router/cloudflare": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "isbot": "^5.2.1",
    "lucide-react": "^1.4.0",
    "markdown-it": "^15.0.0",
    "marked": "^17.0.1",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.118.0"
  }
}
